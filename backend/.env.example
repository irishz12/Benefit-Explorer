# Amazon Bedrock Mantle (server-side only; never expose this key in the frontend)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
MANTLE_MODEL=qwen.qwen3-next-80b-a3b-instruct
MANTLE_MAX_OUTPUT_TOKENS=1100

# Optional RAGAS evaluation judge configuration
RAGAS_JUDGE_MODEL=openai.gpt-oss-120b
RAGAS_MAX_OUTPUT_TOKENS=1800

# Local retrieval and reranking
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=8
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=insurance_products
RAG_OFFLINE=true

# Optional: pin a specific torch device instead of Sentence Transformers'
# automatic selection. Leave unset/blank to keep automatic device selection
# (safest default across macOS, Linux, and CI, which may not have MPS/CUDA).
# EMBEDDING_DEVICE=cpu
# RERANKER_DEVICE=mps

# Comma-separated browser origins allowed by FastAPI
FRONTEND_ORIGINS=http://localhost:3000
