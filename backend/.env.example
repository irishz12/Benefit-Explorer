# Amazon Bedrock Mantle (server-side only; never expose this key in the frontend)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
MANTLE_MODEL=qwen.qwen3-32b
MANTLE_MAX_OUTPUT_TOKENS=1100

# Dual-judge evaluation. Both judges use the Bedrock Mantle credentials above.
# The independent judge must be from a different model family than MANTLE_MODEL.
INDEPENDENT_JUDGE_MODEL=openai.gpt-oss-120b
RAGAS_MAX_OUTPUT_TOKENS=16384

# Local retrieval and reranking
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=insurance_products
RAG_OFFLINE=true

# Comma-separated browser origins allowed by FastAPI
FRONTEND_ORIGINS=http://localhost:3000
